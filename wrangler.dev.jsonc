{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "digitalcardbox-app-dev",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "migrations": [{ "tag": "review-v1", "new_sqlite_classes": ["ReviewStore"] }],
  "vars": { "DCB_ENV": "dev", "AI_CARDS_ENABLED": "true" },
  "durable_objects": {
    "bindings": [{ "name": "REVIEW", "class_name": "ReviewStore" }],
  },
  "previews": {
    "vars": { "DCB_ENV": "dev", "AI_CARDS_ENABLED": "true" },
    "durable_objects": {
      "bindings": [{ "name": "REVIEW", "class_name": "ReviewStore" }],
    },
  },
}
