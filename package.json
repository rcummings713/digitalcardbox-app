{
  "name": "digitalcardbox-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:planning": "python3 planning/check_backlog.py",
    "test:ui": "playwright test",
    "dev:ui": "vite",
    "api": "node server/index.mjs",
    "test:api": "node --test server/tests/*.test.mjs",
    "test:connected": "playwright test --config playwright.connected.config.ts",
    "test:worker": "node --test worker/tests/*.test.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsqr": "1.4.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
